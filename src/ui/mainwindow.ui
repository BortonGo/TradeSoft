          <item>
           <widget class="QTableView" name="tableTrades">
            <property name="styleSheet">
             <string notr="true">QTableView, QTableWidget {
    background-color: #1B1B1B;
    alternate-background-color: #202020;
    color: #E6E6E6;

    gridline-color: #2D2D2D;
    border: 1px solid #2A2A2A;
    border-radius: 6px;

    selection-background-color: #2F5B8A;
    selection-color: #FFFFFF;

    outline: 0;
}

QTableView::item, QTableWidget::item {
    padding: 6px 10px;          /* читабельные отступы */
    border: 0px;
}

QTableView::item:selected, QTableWidget::item:selected {
    background: #2F5B8A;
    color: #FFFFFF;
}

QTableView::item:hover, QTableWidget::item:hover {
    background: #262626;
}

/* Шапка (горизонтальная и вертикальная) */
QHeaderView::section {
    background-color: #262626;
    color: #DCDCDC;
    padding: 7px 10px;
    border: 1px solid #2F2F2F;
    font-weight: 600;
}

QHeaderView::section:hover {
    background-color: #2B2B2B;
}

QHeaderView::section:pressed {
    background-color: #303030;
}

/* Убираем некрасивый уголок слева сверху */
QTableCornerButton::section {
    background-color: #262626;
    border: 1px solid #2F2F2F;
}

/* Если редактируешь ячейки */
QTableView QLineEdit, QTableWidget QLineEdit {
    background: #141414;
    color: #FFFFFF;
    border: 1px solid #3A3A3A;
    border-radius: 4px;
    padding: 4px 6px;
}

/* Линия разделителя / фон под хедером иногда &quot;светит&quot; — глушим */
QHeaderView {
    background-color: #1B1B1B;
}

/* Скроллбар в тему */
QScrollBar:vertical {
    background: #161616;
    width: 12px;
    margin: 12px 2px 12px 2px;
    border: 1px solid #2A2A2A;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background: #2F2F2F;
    min-height: 28px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover { background: #3A3A3A; }
QScrollBar::handle:vertical:pressed { background: #4A4A4A; }

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: #161616;
    height: 10px;
    border: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }

QScrollBar:horizontal {
    background: #161616;
    height: 12px;
    margin: 2px 12px 2px 12px;
    border: 1px solid #2A2A2A;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background: #2F2F2F;
    min-width: 28px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover { background: #3A3A3A; }
QScrollBar::handle:horizontal:pressed { background: #4A4A4A; }

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    background: #161616;
    width: 10px;
    border: 0px;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }</string>
            </property>
           </widget>
          </item>
         </layout>
