                <string notr="true">QGroupBox {
    background-color: #1B1B1B;
    border: 1px solid #2E2E2E;
    border-radius: 6px;
    margin-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    color: #FF8C1A;
    font-weight: bold;
}

QLineEdit, QDoubleSpinBox, QSpinBox, QComboBox {
    background-color: #222222;
    border: 1px solid #2E2E2E;
    border-radius: 4px;
    padding: 4px;
    color: #EAEAEA;
}

QLineEdit:focus, QDoubleSpinBox:focus {
    border: 1px solid #FF8C1A;
}

QLabel {
    color: #9A9A9A;
}

QCheckBox {
    spacing: 6px;
    color: #EAEAEA;
}

QGroupBox:disabled {
    color: #666;
}

QGroupBox:disabled QComboBox,
QGroupBox:disabled QSpinBox,
QGroupBox:disabled QDoubleSpinBox,
QGroupBox:disabled QCheckBox {
    background-color: #151515;
    color: #444;
    border: 1px solid #252525;
}

</string>
